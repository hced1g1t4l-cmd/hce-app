# Copie este arquivo para .env.local e preencha os valores.
# NUNCA comite o .env.local (ele ja esta no .gitignore).

# Banco PostgreSQL (Neon). Pegue as connection strings em https://neon.tech
# DATABASE_URL: conexao "pooled" (host com -pooler), usada pelo app em runtime.
# DIRECT_URL: conexao direta (host sem -pooler), usada pelas migracoes do Prisma.
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=""
DIRECT_URL=""

# Segredo do Auth.js. Gere um com:  npx auth secret
AUTH_SECRET=""

# URL publica do app (sem barra no final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Painel /adm (listagem de leads do Clube +HCE).
# Se nao definir, o app usa um usuario/senha padrao ja embutidos (troque em producao!).
# ADMIN_PASSWORD (texto puro) OU ADMIN_PASSWORD_HASH (sha256 hex).
ADMIN_USER="hce.d1g1t4l"
ADMIN_PASSWORD=""

# Google reCAPTCHA v2 (opcional). Sem chaves, o form usa verificacao anti-bot simples.
# Crie em https://www.google.com/recaptcha/admin (tipo v2 "Nao sou um robo").
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# E-mail transacional (recuperacao de senha, verificacao de e-mail) via API do Brevo.
# Sem BREVO_API_KEY o app nao envia e-mails (retorna erro claro na tela).
# Crie a chave em https://app.brevo.com (SMTP & API > API Keys).
# EMAIL_FROM precisa ser um remetente/dominio autenticado no Brevo (DKIM/SPF).
BREVO_API_KEY=""
EMAIL_FROM="naoresponda@hcegastronomia.com"
EMAIL_FROM_NAME="HCE"

# Cloudflare R2 (biblioteca de midia: fichas, e-books, planilhas, imagens).
# Sem essas variaveis, o upload no /adm/midia fica desabilitado (o resto funciona).
# Crie um bucket em https://dash.cloudflare.com > R2 e um token de API do R2.
# R2_ACCOUNT_ID: ID da conta (aparece no endpoint S3 do bucket).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: credenciais do token de API do R2.
# R2_BUCKET: nome do bucket (ex.: hce-midia).
# R2_PUBLIC_BASE_URL: (opcional) dominio publico do bucket p/ arquivos publicos,
#   ex.: https://cdn.hcegastronomia.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Sentry (monitoramento de erros, opcional). Sem DSN o Sentry fica inerte.
# Crie um projeto Next.js em https://sentry.io e pegue o DSN.
# NEXT_PUBLIC_SENTRY_DSN: DSN publico (client + server).
NEXT_PUBLIC_SENTRY_DSN=""
# Abaixo, so para upload de source maps no build (opcional):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
