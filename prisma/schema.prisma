// Schema do banco do HCE (PostgreSQL / Neon).
// Modelos base do Auth.js (User/Account/Session/VerificationToken) + campo de papel.
// Rode `npm run db:generate` para gerar o client e `npm run db:push` para criar as tabelas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexao "pooled" (com -pooler) usada pelo app em runtime (serverless/Vercel).
  url       = env("DATABASE_URL")
  // Conexao direta (sem -pooler) usada pelas migracoes (prisma db push/migrate).
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  // Frente A: conta de usuario do site (cadastro free obrigatorio p/ ler o Feed).
  passwordHash       String? // hash scrypt (scrypt$salt$hash); null = so login social (futuro)
  telefone           String?
  aceitaComunicacoes Boolean @default(false) // consentimento LGPD p/ novidades
  plano              String  @default("free") // free | essencial | profissional | premium
  ultimoAcesso       DateTime? // atualizado quando a pessoa navega logada (throttle ~10min)
  // Perfil editavel pela pessoa em /conta.
  bio                String? // pequena apresentacao
  endereco           String? // legado (texto livre) - mantido por compatibilidade
  // Endereco estruturado.
  cep                String? // CEP (so digitos), usado p/ autocompletar
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String? // UF (SP, RJ...) ou "N/A" (nao se aplica)
  pais               String? // nome do pais
  linkedin           String? // URL do perfil
  instagram          String? // URL do perfil
  facebook           String? // URL do perfil
  handle             String?   @unique // @ publico do usuario (comentarios)
  // image (avatar) ja existe acima; guarda /api/img/{id} da foto reduzida.
  accounts      Account[]
  sessions      Session[]
  reacoes       ArtigoReacao[]
  comentarios   Comentario[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Conta de administrador do painel /adm. Substitui o login unico por
// variavel de ambiente: cada pessoa tem login, senha (scrypt) e perfil.
// Qualquer admin ativo pode cadastrar outros admins.
model Admin {
  id                 String    @id @default(cuid())
  login              String    @unique // ex.: cris.leite
  nome               String
  senhaHash          String // scrypt$salt$hash
  fotoUrl            String? // /api/img/{id} da foto reduzida
  emailPrincipal     String? // resgate de senha (principal)
  emailSecundario    String? // resgate de senha (alternativo)
  precisaTrocarSenha Boolean   @default(true) // forca troca no 1o acesso
  ativo              Boolean   @default(true)
  ultimoAcesso       DateTime?
  criadoPor          String? // login de quem criou (auditoria)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions AdminSession[]
  logs     AdminLog[]

  @@index([ativo])
}

// Sessao de admin guardada no banco (permite revogar em logout/reset).
model AdminSession {
  sessionToken String   @unique
  adminId      String
  expires      DateTime
  createdAt    DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Token de uso unico para "esqueci a senha" do admin (guardamos o hash).
model AdminResetToken {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expires   DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
}

// Log de auditoria do painel: quem fez o que e quando.
// adminId pode ser null em falhas de login (nao ha sessao).
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminLogin String // denormalizado (sobrevive a exclusao/edicao)
  acao       String // ex.: login, logout, senha.trocar, admin.criar, artigo.publicar
  detalhe    String? // texto curto/JSON com contexto
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminLogin])
  @@index([acao])
}

// Lead de captacao para o lancamento do Clube +HCE (RAF_007).
// Coletado no formulario publico /avise-me; consultado apenas no /adm.
model ClubeLead {
  id            String   @id @default(cuid())
  nome          String
  email         String
  telefone      String
  // Canais que a pessoa autorizou receber aviso do lancamento.
  canalEmail    Boolean  @default(false)
  canalSms      Boolean  @default(false)
  canalWhatsapp Boolean  @default(false)
  // Autorizacao para outras comunicacoes e promocoes.
  aceitaPromos  Boolean  @default(false)
  ip            String?
  userAgent     String?
  observacoes   String? // anotacoes internas do time (editavel no /adm)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// Registro de acesso ao site para o painel de analytics (RAF_013).
// Um registro por pageview publico. visitorId (cookie 1a parte) permite contar
// "usuarios unicos"; cidade/lat/lng vem do geo-IP da Vercel para o mapa.
model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  country   String?
  region    String?
  city      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([city])
}

// Artigo do Feed HCE (F1-5): blog/CMS em tom de materia.
// Criado e editado no /adm/feed (editor rico TipTap); publicado em /feed.
// conteudoHtml guarda o HTML do editor; capaUrl aponta para /api/img/{id}.
model Artigo {
  id           String    @id @default(cuid())
  slug         String    @unique
  titulo       String
  resumo       String? // "olho"/subtitulo da materia
  capaUrl      String? // URL da imagem de capa (/api/img/{id} ou externa)
  autor        String // "Redigido por ..."
  conteudoHtml String    @db.Text
  galeria      String[]  @default([]) // fotos extras (carrossel a partir da capa), até 5
  publicado    Boolean   @default(false)
  publicadoEm  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reacoes     ArtigoReacao[]
  comentarios Comentario[]

  @@index([publicado, publicadoEm])
}

// Reacao de um usuario a um artigo (estilo LinkedIn). Uma por usuario/artigo;
// tipo em: gostei | amei | aplausos | inspirador (ver lib/reacoes.ts).
model ArtigoReacao {
  artigoId  String
  userId    String
  tipo      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artigo Artigo @relation(fields: [artigoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([artigoId, userId])
  @@index([artigoId, tipo])
}

// Comentario de usuario em um artigo. Passa por moderacao no /adm:
// status = pendente | aprovado | reprovado. So aparece no site se aprovado.
model Comentario {
  id         String    @id @default(cuid())
  artigoId   String
  userId     String
  texto      String    @db.Text
  status     String    @default("pendente")
  moderadoEm DateTime?
  moderadoPor String? // login do admin que moderou
  createdAt  DateTime  @default(now())

  artigo Artigo @relation(fields: [artigoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([artigoId, status])
  @@index([status, createdAt])
}

// Imagem armazenada no proprio Postgres (capa e imagens do corpo dos artigos).
// Servida publicamente por /api/img/{id}. Enviada via /api/adm/upload (protegido).
model Imagem {
  id        String   @id @default(cuid())
  mime      String
  dados     Bytes
  createdAt DateTime @default(now())
}

// Frente B: biblioteca de midia (fichas tecnicas, e-books, planilhas, imagens).
// Os bytes ficam no Cloudflare R2 (S3-compativel); aqui guardamos so o metadado.
// Entrega:
//   - publico  -> /api/midia/{id} redireciona p/ URL (CDN ou assinada)
//   - privado  -> /api/midia/{id} exige login + plano >= planoMinimo e assina URL curta
model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique // caminho do objeto no bucket R2
  filename     String // nome original do arquivo
  titulo       String? // rotulo amigavel exibido no painel
  mime         String
  tamanho      Int // bytes
  tipo         String // imagem | pdf | ebook | planilha | outro
  visibilidade String   @default("privado") // publico | privado
  planoMinimo  String   @default("free") // free | essencial | profissional | premium
  createdAt    DateTime @default(now())

  @@index([tipo])
  @@index([createdAt])
}

// Mensagem do formulario "Fale com a HCE" (RAF_008).
// Coletada em /fale-com-a-hce; consultada apenas no /adm/contatos.
model ContatoMensagem {
  id              String   @id @default(cuid())
  nome            String
  email           String
  telefone        String?
  mensagem        String
  // Permissoes de contato que a pessoa autorizou.
  permiteEmail    Boolean  @default(false)
  permiteTelefone Boolean  @default(false)
  permiteWhatsapp Boolean  @default(false)
  ip              String?
  userAgent       String?
  observacoes     String? // anotacoes internas do time (editavel no /adm)
  createdAt       DateTime @default(now())

  @@index([createdAt])
}
