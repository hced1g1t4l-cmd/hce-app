// Schema do banco do HCE (PostgreSQL / Neon).
// Modelos base do Auth.js (User/Account/Session/VerificationToken) + campo de papel.
// Rode `npm run db:generate` para gerar o client e `npm run db:push` para criar as tabelas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexao "pooled" (com -pooler) usada pelo app em runtime (serverless/Vercel).
  url       = env("DATABASE_URL")
  // Conexao direta (sem -pooler) usada pelas migracoes (prisma db push/migrate).
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  // Frente A: conta de usuario do site (cadastro free obrigatorio p/ ler o Feed).
  passwordHash       String? // hash scrypt (scrypt$salt$hash); null = so login social (futuro)
  telefone           String?
  aceitaComunicacoes Boolean @default(false) // consentimento LGPD p/ novidades
  plano              String  @default("free") // free | essencial | profissional | premium
  // Assinatura paga (Clube +HCE via Asaas, BAC_143). statusAssinatura reflete o
  // ciclo de cobranca; asaasCustomerId reaproveita o mesmo cliente no provedor
  // entre assinaturas. O `plano` acima continua sendo a fonte do gating; ele so
  // "sobe" quando ha assinatura ativa e "cai" para free ao cancelar/inadimplir.
  statusAssinatura   String  @default("nenhuma") // nenhuma | trial | ativa | inadimplente | cancelada
  asaasCustomerId    String? @unique
  ultimoAcesso       DateTime? // atualizado quando a pessoa navega logada (throttle ~10min)
  // Perfil editavel pela pessoa em /conta.
  bio                String? // pequena apresentacao
  endereco           String? // legado (texto livre) - mantido por compatibilidade
  // Endereco estruturado.
  cep                String? // CEP (so digitos), usado p/ autocompletar
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String? // UF (SP, RJ...) ou "N/A" (nao se aplica)
  pais               String? // nome do pais
  linkedin           String? // URL do perfil
  instagram          String? // URL do perfil
  facebook           String? // URL do perfil
  handle             String?   @unique // @ publico do usuario (comentarios)
  // image (avatar) ja existe acima; guarda /api/img/{id} da foto reduzida.
  accounts      Account[]
  sessions      Session[]
  reacoes       ArtigoReacao[]
  comentarios   Comentario[]
  feedAcessos   FeedAcesso[]
  assinaturas   Assinatura[]
  pagamentos    Pagamento[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Conta de administrador do painel /adm. Substitui o login unico por
// variavel de ambiente: cada pessoa tem login, senha (scrypt) e perfil.
// Qualquer admin ativo pode cadastrar outros admins.
model Admin {
  id                 String    @id @default(cuid())
  login              String    @unique // ex.: cris.leite
  nome               String
  senhaHash          String // scrypt$salt$hash
  fotoUrl            String? // /api/img/{id} da foto reduzida
  emailPrincipal     String? // resgate de senha (principal)
  emailSecundario    String? // resgate de senha (alternativo)
  precisaTrocarSenha Boolean   @default(true) // forca troca no 1o acesso
  ativo              Boolean   @default(true)
  tentativasFalhas   Int       @default(0) // logins invalidos consecutivos
  bloqueadoAte       DateTime? // conta bloqueada por brute-force ate esta data
  ultimoAcesso       DateTime?
  criadoPor          String? // login de quem criou (auditoria)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions    AdminSession[]
  logs        AdminLog[]
  comentarios Comentario[] // respostas oficiais da HCE no Feed

  @@index([ativo])
}

// Sessao de admin guardada no banco (permite revogar em logout/reset).
model AdminSession {
  sessionToken String   @unique
  adminId      String
  expires      DateTime
  createdAt    DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Token de uso unico para "esqueci a senha" do admin (guardamos o hash).
model AdminResetToken {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expires   DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
}

// Log de auditoria do painel: quem fez o que e quando.
// adminId pode ser null em falhas de login (nao ha sessao).
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminLogin String // denormalizado (sobrevive a exclusao/edicao)
  acao       String // ex.: login, logout, senha.trocar, admin.criar, artigo.publicar
  detalhe    String? // texto curto/JSON com contexto
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminLogin])
  @@index([acao])
}

// Lead de captacao para o lancamento do Clube +HCE (RAF_007).
// Coletado no formulario publico /avise-me; consultado apenas no /adm.
model ClubeLead {
  id            String   @id @default(cuid())
  nome          String
  email         String
  telefone      String
  // Canais que a pessoa autorizou receber aviso do lancamento.
  canalEmail    Boolean  @default(false)
  canalSms      Boolean  @default(false)
  canalWhatsapp Boolean  @default(false)
  // Autorizacao para outras comunicacoes e promocoes.
  aceitaPromos  Boolean  @default(false)
  ip            String?
  userAgent     String?
  observacoes   String? // anotacoes internas do time (editavel no /adm)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// Registro de acesso ao site para o painel de analytics (RAF_013).
// Um registro por pageview publico. visitorId (cookie 1a parte) permite contar
// "usuarios unicos"; cidade/lat/lng vem do geo-IP da Vercel para o mapa.
model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  country   String?
  region    String?
  city      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([city])
}

// Artigo do Feed HCE (F1-5): blog/CMS em tom de materia.
// Criado e editado no /adm/feed (editor rico TipTap); publicado em /feed.
// conteudoHtml guarda o HTML do editor; capaUrl aponta para /api/img/{id}.
model Artigo {
  id           String    @id @default(cuid())
  slug         String    @unique
  titulo       String
  resumo       String? // "olho"/subtitulo da materia
  capaUrl      String? // URL da imagem de capa (/api/img/{id} ou externa)
  capaCredito  String? // fonte/crédito da imagem de capa (ex.: "Foto: Divulgação HCE")
  autor        String // "Redigido por ..."
  conteudoHtml String    @db.Text
  galeria      String[]  @default([]) // fotos extras (carrossel a partir da capa), até 5
  galeriaCreditos String[] @default([]) // fonte de cada foto da galeria, alinhado por índice
  publicado    Boolean   @default(false)
  publicadoEm  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reacoes     ArtigoReacao[]
  comentarios Comentario[]
  acessos     FeedAcesso[]

  @@index([publicado, publicadoEm])
}

// Metricas de leitura do Feed HCE (BAC_109). Um registro por acesso de um
// usuario logado ao indice do Feed (artigoId null) ou a um artigo especifico.
// durationMs e preenchido por um beacon no cliente (tempo de permanencia).
// Vinculado a conta (userId) para responder "quais perfis acessaram".
model FeedAcesso {
  id         String   @id @default(cuid())
  userId     String
  artigoId   String? // null = indice /feed; preenchido = artigo especifico
  durationMs Int? // tempo de permanencia em ms (beacon)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artigo Artigo? @relation(fields: [artigoId], references: [id], onDelete: Cascade)

  @@index([artigoId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Reacao de um usuario a um artigo (estilo LinkedIn). Uma por usuario/artigo;
// tipo em: gostei | amei | aplausos | inspirador (ver lib/reacoes.ts).
model ArtigoReacao {
  artigoId  String
  userId    String
  tipo      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artigo Artigo @relation(fields: [artigoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([artigoId, userId])
  @@index([artigoId, tipo])
}

// Comentario de usuario em um artigo. Passa por moderacao no /adm:
// status = pendente | aprovado | reprovado. So aparece no site se aprovado.
//
// Respostas (BAC_108): parentId aponta para o comentario respondido (1 nivel).
// Autor pode ser um membro (userId) OU um administrador da HCE (adminId). As
// respostas da HCE ja nascem "aprovado"; as de membros passam por moderacao.
model Comentario {
  id         String    @id @default(cuid())
  artigoId   String
  userId     String? // autor membro (null quando a resposta e da HCE)
  adminId    String? // autor administrador (resposta oficial da HCE)
  parentId   String? // se preenchido, e uma resposta a outro comentario
  texto      String    @db.Text
  status     String    @default("pendente")
  moderadoEm DateTime?
  moderadoPor String? // login do admin que moderou
  createdAt  DateTime  @default(now())

  artigo Artigo @relation(fields: [artigoId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin  Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  parent    Comentario?  @relation("Respostas", fields: [parentId], references: [id], onDelete: Cascade)
  respostas Comentario[] @relation("Respostas")

  @@index([artigoId, status])
  @@index([status, createdAt])
  @@index([parentId])
}

// Imagem armazenada no proprio Postgres (capa e imagens do corpo dos artigos).
// Servida publicamente por /api/img/{id}. Enviada via /api/adm/upload (protegido).
model Imagem {
  id        String   @id @default(cuid())
  mime      String
  dados     Bytes
  createdAt DateTime @default(now())
}

// Frente B: biblioteca de midia (fichas tecnicas, e-books, planilhas, imagens).
// Os bytes ficam no Cloudflare R2 (S3-compativel); aqui guardamos so o metadado.
// Entrega:
//   - publico  -> /api/midia/{id} redireciona p/ URL (CDN ou assinada)
//   - privado  -> /api/midia/{id} exige login + plano >= planoMinimo e assina URL curta
model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique // caminho do objeto no bucket R2
  filename     String // nome original do arquivo
  titulo       String? // rotulo amigavel exibido no painel
  mime         String
  tamanho      Int // bytes
  tipo         String // imagem | pdf | ebook | planilha | outro
  visibilidade String   @default("privado") // publico | privado
  planoMinimo  String   @default("free") // free | essencial | profissional | premium
  createdAt    DateTime @default(now())

  @@index([tipo])
  @@index([createdAt])
}

// Card da secao publica "Na Midia" (BAC_130): coluna, podcast, entrevista,
// video ou artigo ja publicado por Cris/Gio na imprensa e nas redes.
// Editavel pelo /adm/na-midia (CRUD, reordenacao e publicar/despublicar), sem
// deploy. Substitui o array fixo que existia em src/app/na-midia/page.tsx.
//   - descricao: texto de apoio (curto), armazenado como texto puro.
//   - linksExtras: Json com [{ label, url }] (chips no rodape do card).
//   - thumbUrl/avatarUrl: /api/img/{id} (upload local ou og:image baixada) ou
//     caminho local /brand/... — sempre mesma origem (nada de hotlink externo).
//   - ordem: menor primeiro; publicado controla a exibicao no site.
model MidiaItem {
  id          String  @id @default(cuid())
  tipo        String  @default("Coluna") // Coluna | Podcast | Entrevista | Vídeo | Artigo
  veiculo     String
  autor       String
  titulo      String
  descricao   String  @db.Text
  url         String
  linksExtras Json    @default("[]") // [{ label, url }]
  thumbUrl    String? // /api/img/{id} (upload/og:image) — mesma origem
  thumbPos    String? // object-position do recorte (ex.: "center 22%")
  avatarUrl   String? // /api/img/{id} ou /brand/fotos/...
  logoVeiculo String? // selo do veiculo (ex.: /brand/midia/logo-extra.svg)
  logoAlt     String? // texto alternativo do logo (ex.: "Extra")
  logoClasse  String? // ajuste de tamanho do logo no selo (ex.: "h-4 w-auto")
  ordem       Int     @default(0)
  publicado   Boolean @default(true)

  criadoPorLogin String
  criadoPorNome  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicado, ordem])
  @@index([ordem])
}

// Depoimento/comentario exibido na home (BAC_110/BAC_137). Curadoria feita no
// /adm/depoimentos: escolher o que entra, a ordem e o formato, sem depender do
// dev. Substitui o array fixo que existia em components/site/depoimentos-home.
//   - texto: depoimento (texto puro; a home renderiza com quebras de linha).
//   - fotoUrl: avatar (/api/img/{id} de upload ou /brand/depoimentos/...).
//   - formato: texto | imagem | video (video reservado p/ o futuro — pesa o
//     site, então priorizamos texto/imagem no curto prazo).
//   - ordem menor primeiro; publicado controla a exibicao no site.
model Depoimento {
  id        String  @id @default(cuid())
  nome      String
  cargo     String
  texto     String  @db.Text
  fotoUrl   String? // /api/img/{id} (upload) ou /brand/depoimentos/... — mesma origem
  formato   String  @default("texto") // texto | imagem | video
  ordem     Int     @default(0)
  publicado Boolean @default(true)

  criadoPorLogin String
  criadoPorNome  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicado, ordem])
  @@index([ordem])
}

// Item de backlog interno do time (modulo /adm/backlog).
// Qualquer admin cria; codigo sequencial BAC_001 e derivado na listagem.
// descricao = HTML (permite colar imagens via Ctrl+V, embutidas como /api/img/{id}).
// prioridade = alta | media | baixa
// status = aberto | em_andamento | concluido | cancelado
// Guardamos quem/quando de cada transicao (nome do admin, para exibir sem join).
model BacklogItem {
  id         String @id @default(cuid())
  titulo     String
  descricao  String @db.Text
  prioridade String @default("media")
  status     String @default("aberto")

  // Data de vencimento (opcional). Armazenada como meio-dia UTC do dia
  // escolhido para nunca "voltar" um dia ao formatar em America/Sao_Paulo.
  prazo      DateTime?

  criadoPorLogin String
  criadoPorNome  String

  iniciadoEm      DateTime?
  iniciadoPorNome String?
  concluidoEm      DateTime?
  concluidoPorNome String?
  canceladoEm      DateTime?
  canceladoPorNome String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// Mensagem do formulario "Fale com a HCE" (RAF_008).
// Coletada em /fale-com-a-hce; consultada apenas no /adm/contatos.
model ContatoMensagem {
  id              String   @id @default(cuid())
  nome            String
  email           String
  telefone        String?
  mensagem        String
  // Permissoes de contato que a pessoa autorizou.
  permiteEmail    Boolean  @default(false)
  permiteTelefone Boolean  @default(false)
  permiteWhatsapp Boolean  @default(false)
  ip              String?
  userAgent       String?
  observacoes     String? // anotacoes internas do time (editavel no /adm)
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Contador compartilhado entre instancias serverless (rate-limit.ts).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// ===========================================================================
// Assinaturas e pagamentos do Clube +HCE (gateway Asaas — BAC_143/144/145).
// Valores monetarios em CENTAVOS (Int) para evitar erros de ponto flutuante.
// O provedor guarda o "id externo" (asaas*Id); nunca guardamos dados de cartao
// (tokenizacao fica no provedor, PCI-DSS). Ver estudo em HCE/docs/.
// ===========================================================================

// Assinatura recorrente de um usuario a um plano pago.
// status: trial | ativa | inadimplente | cancelada.
model Assinatura {
  id                  String    @id @default(cuid())
  userId              String
  plano               String // chave interna do plano: essencial | profissional
  provedor            String    @default("asaas")
  asaasCustomerId     String? // cliente no provedor (denormalizado do User)
  asaasSubscriptionId String?   @unique // id da assinatura no provedor
  status              String    @default("trial")
  metodo              String? // CREDIT_CARD | PIX | BOLETO
  valorCentavos       Int? // valor do ciclo (auditoria)
  inicioEm            DateTime  @default(now())
  fimPeriodoAtual     DateTime? // ate quando o acesso esta pago
  canceladaEm         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([userId])
  @@index([status])
}

// Um lancamento de cobranca (uma fatura). Ligado a uma assinatura quando
// recorrente; userId sempre preenchido para consulta rapida no /adm.
// status espelha o provedor: PENDING | CONFIRMED | RECEIVED | OVERDUE | REFUNDED...
model Pagamento {
  id             String    @id @default(cuid())
  assinaturaId   String?
  userId         String
  provedor       String    @default("asaas")
  asaasPaymentId String    @unique // id da cobranca no provedor (idempotencia)
  valorCentavos  Int
  metodo         String? // CREDIT_CARD | PIX | BOLETO
  status         String
  pagoEm         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assinatura Assinatura? @relation(fields: [assinaturaId], references: [id], onDelete: SetNull)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nota       NotaFiscal?

  @@index([userId, createdAt])
  @@index([assinaturaId])
  @@index([status])
}

// Nota fiscal de servico (NFS-e) emitida para um pagamento aprovado.
// status: pendente | emitida | erro | cancelada. Uma nota por pagamento.
model NotaFiscal {
  id          String    @id @default(cuid())
  pagamentoId String    @unique
  asaasNotaId String? // id da NF no provedor
  numero      String? // numero da nota emitida
  status      String    @default("pendente")
  pdfUrl      String? // link do PDF (enviado por e-mail ao cliente)
  xmlUrl      String?
  emitidaEm   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pagamento Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
}
